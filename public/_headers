# Same security headers as vercel.json source "/(.*)".
# Netlify applies this to the file it actually serves, including 404.html and spa.html.
# Keep the values in sync with scripts/csp.mjs (tests/seo.mjs checks).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(self), xr-spatial-tracking=(self)
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; frame-src 'none'; script-src 'self' 'wasm-unsafe-eval' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://*.supabase.co; media-src 'self' blob:; connect-src 'self' blob: data: https://fonts.googleapis.com https://fonts.gstatic.com https://*.supabase.co; worker-src 'self' blob:; child-src 'self' blob:
  X-Frame-Options: SAMEORIGIN

# Private booth and guest-photo URLs. Vercel sets the same tag in vercel.json.
/booth/*
  X-Robots-Tag: noindex, nofollow
/p/*
  X-Robots-Tag: noindex, nofollow
