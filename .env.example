# Copy to .env.local and fill in. All values are optional; empty values are hidden on the site.
# Vite only exposes variables prefixed with VITE_. Restart `npm run dev` after editing.

# Public contact details shown on the Contact page and footer
# (email defaults to thenerdstudio@gmail.com in src/config/site.ts)
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=
VITE_CONTACT_ADDRESS=
VITE_CONTACT_HOURS=

# Optional: an HTTPS endpoint that accepts a JSON POST (e.g. Formspree, Getform, your own API).
# When set, the contact form sends submissions there. When empty, the form opens the
# visitor's email app addressed to VITE_CONTACT_EMAIL instead.
VITE_FORM_ENDPOINT=

# LINE Official Account: add-friend link and the ID shown on the site
VITE_LINE_URL=
VITE_LINE_ID=

# Optional social links (full https:// URLs)
VITE_FACEBOOK_URL=
VITE_LINKEDIN_URL=
VITE_INSTAGRAM_URL=
VITE_GITHUB_URL=

# Optional: WebSocket feed for the Digital Twin page (wss://…). Empty = built-in simulator.
VITE_TWIN_WS_URL=

# AR Photo Booth Studio (see docs/BOOTH-STUDIO-TH.md). Empty = the booth runs in demo mode and photos stay on the device.
# Both values are public by design: access is controlled by the database (row level security), not by hiding them.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional: base URL in the guests' QR codes if it differs from the booth's address (e.g. a custom domain).
VITE_PUBLIC_URL=
